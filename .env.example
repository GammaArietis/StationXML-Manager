# Copiare questo file in `.env` e adattare i valori al deployment.
#
# StationXML Manager legge la configurazione tramite `core.config.AppSettings`
# e, per il secret di sessione NiceGUI, dall'ambiente di processo.

# Modalita' generale di runtime.
# In produzione mantenere DEBUG=false. DEBUG=true e' pensato solo per sviluppo
# locale attendibile, perche' abilita comportamenti piu' permissivi come il CORS wildcard.
DEBUG=false

# Percorso del database SQLite.
# Il database viene inizializzato automaticamente all'avvio sia dall'entrypoint
# Desktop sia da quello Web. Mantenere stabile questo path se Desktop e Web
# lavorano sullo stesso archivio metadati.
DATABASE_PATH=data/stationxml.db

# Schema SQL usato per primo avvio e inizializzazioni idempotenti.
SCHEMA_PATH=database/schema.sql

# Logging.
# LOG_FILE_PATH e' il file usato dal logging centralizzato.
# LOG_LEVEL documenta la verbosita' desiderata per il deployment. Se
# l'applicazione viene estesa con filtro log da ambiente, usare livelli Python:
# DEBUG, INFO, WARNING, ERROR o CRITICAL.
LOG_FILE_PATH=app.log
LOG_LEVEL=INFO

# Segreto di firma per lo storage sessione per-utente di NiceGUI.
# CRITICO IN PRODUZIONE WEB:
# `main_nicegui.py` salva lo stato di navigazione/sessione in `app.storage.user`
# per evitare che utenti browser diversi condividano rete/stazione/canale
# correnti. NiceGUI firma quello storage browser-backed con
# NICEGUI_STORAGE_SECRET. Se il valore e' debole, riusato tra deployment non
# correlati o committato come secret reale, si perde integrita' del session
# storage e l'applicazione puo' diventare esposta a manomissioni.
#
# Generare un valore lungo e casuale per produzione, per esempio:
#   python - <<'PY'
#   import secrets
#   print(secrets.token_urlsafe(48))
#   PY
#
# Non usare mai il valore di esempio in produzione.
NICEGUI_STORAGE_SECRET=change-me-generate-a-long-random-secret-for-production

# Origini browser consentite (lista separata da virgole, senza spazi superflui dopo la virgola).
# In produzione (DEBUG=false) CORS_ORIGINS=* viene ignorato: imposta gli URL reali del front-end.
# Esempio produzione:
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Sviluppo locale:
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Solo con DEBUG=true: accetta tutte le origini (non usare in produzione)
# CORS_ORIGINS=*

# Limite richieste API per IP e minuto (prefisso /api/). 0 = disattivato.
API_RATE_LIMIT_PER_MINUTE=120

# Endpoint di integrazione Yasmine.
# E' l'endpoint esterno StationXML/SCADA usato dalle azioni di sync.
YASMINE_BASE_URL=http://127.0.0.1:1841
